<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Terminal client butuh menjalankan proses shell & koneksi jaringan,
	     sehingga app-sandbox dimatikan. Nyalakan kembali (dengan entitlement
	     khusus) jika menargetkan distribusi via Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
